# Copy to .env.local and fill in. Validated at runtime by src/lib/config/env.ts.

# ── App ──
APP_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024

# ── Security ──
# 32 random bytes as hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Any random string ≥16 chars; Vercel Cron and Supabase pg_cron send it as "Authorization: Bearer <CRON_SECRET>"
# (pg_cron reads its copy from the Vault secret `keeper_cron_secret`: keep both equal).
CRON_SECRET=

# ── Demo tenant (MVP / pitch) ──
DEMO_BUSINESS_SLUG=spa-demo
DEMO_OWNER_EMAIL=demo@keeper.app
DEMO_OWNER_PASSWORD=
# Signs the simulated checkout → payments webhook (≥16 chars)
DEMO_PAYMENT_WEBHOOK_SECRET=
DEMO_MAX_MESSAGES_PER_SESSION=30
DEMO_DAILY_MESSAGE_BUDGET=1500

# ── WhatsApp Cloud API (live tenants only) ──
# Keeper-level Meta app config. Each business's own number is `businesses.whatsapp_phone_number_id`.
# Without WHATSAPP_TOKEN (or without that column), live businesses can't be messaged and crons skip them.
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# ── Google Calendar OAuth (live tenants only) ──
# Keeper's OAuth client. Each business's refresh token is stored encrypted in `integrations`.
# Redirect URI to register in Google Cloud: <APP_URL>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payment gateways (live tenants only) ──
# Base URLs only; leave empty to use the sandbox/lab defaults. Merchant credentials (Azul merchant id,
# name and auth key; Cardnet merchant number and terminal) are PER BUSINESS, stored encrypted in
# `integrations` — never in env. (AZUL_MERCHANT_ID / AZUL_MERCHANT_NAME / AZUL_AUTH_KEY /
# CARDNET_MERCHANT_ID / CARDNET_TERMINAL_ID were removed: nothing reads them.)
# Azul production: https://pagos.azul.com.do/PaymentPage/Default.aspx
AZUL_PAYMENT_PAGE_URL=
CARDNET_API_URL=

# ── Supabase pg_cron (not env) ──
# holds-expiry (every 10 min) and reminders (hourly) are scheduled by supabase/migrations/20261001000000_pg_cron.sql,
# which reads APP_URL and CRON_SECRET from Supabase Vault (`keeper_app_url`, `keeper_cron_secret`). See docs/deploy.md.
