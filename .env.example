# Copy to .env.local and fill in. Validated at runtime by src/lib/config/env.ts.

# ── App ──
APP_URL=http://localhost:3000

# ── Supabase (Project Settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024

# ── Security ──
# 32 random bytes as hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Any random string ≥16 chars; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ── Demo tenant (MVP / pitch) ──
DEMO_BUSINESS_SLUG=spa-demo
DEMO_OWNER_EMAIL=demo@keeper.app
DEMO_OWNER_PASSWORD=
# Signs the simulated checkout → payments webhook (≥16 chars)
DEMO_PAYMENT_WEBHOOK_SECRET=
DEMO_MAX_MESSAGES_PER_SESSION=30
DEMO_DAILY_MESSAGE_BUDGET=1500

# ── WhatsApp Cloud API (live tenants only) ──
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# ── Google Calendar OAuth (live tenants only) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Azul Payment Page (live tenants only) ──
AZUL_MERCHANT_ID=
AZUL_MERCHANT_NAME=
AZUL_AUTH_KEY=
AZUL_PAYMENT_PAGE_URL=

# ── Cardnet (live tenants only) ──
CARDNET_MERCHANT_ID=
CARDNET_TERMINAL_ID=
CARDNET_API_URL=
